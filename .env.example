# Copy to `.env.local` (and add the same keys in Vercel → Project → Settings → Environment Variables).
# Values come from Firebase console → Project settings → Your apps → Web app.
# These values are public client identifiers (not secrets); security is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use the local Firebase Emulator Suite (npm run emulators) instead of the real project.
VITE_USE_FIREBASE_EMULATORS=false

# Path of the FPL proxy. Leave as-is: the Vercel Function (prod) and the Vite dev server both serve /api/fpl.
VITE_FPL_API_BASE=/api/fpl
