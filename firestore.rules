rules_version = '2';

// Data model: see AGENT_GUIDE.md § "Firestore data model".
// Everyone (including anonymous visitors) can read league data; only admins can write.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // An admin is a signed-in user with a verified email that has a document in /admins.
    // Admin documents are created manually in the Firebase console (doc id = lower-case email).
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(callerEmail()));
    }

    function isStamped(d) {
      return d.updatedAt == request.time && d.updatedBy == callerEmail();
    }

    function isValidLeagueSettings(d) {
      return d.keys().hasOnly(['leagueId', 'timeZone', 'updatedAt', 'updatedBy'])
        && d.leagueId is int && d.leagueId > 0
        && d.timeZone is string && d.timeZone.size() > 0 && d.timeZone.size() <= 64
        && isStamped(d);
    }

    function isValidFdrSettings(d) {
      return d.keys().hasOnly(['lastSeasonWeight', 'lastSeasonLabel', 'lastSeasonPositions', 'updatedAt', 'updatedBy'])
        && d.lastSeasonWeight is number && d.lastSeasonWeight >= 0 && d.lastSeasonWeight <= 1
        && d.lastSeasonLabel is string && d.lastSeasonLabel.size() <= 20
        && d.lastSeasonPositions is map && d.lastSeasonPositions.size() <= 40
        && isStamped(d);
    }

    function isValidMonth(d, monthKey) {
      return d.keys().hasOnly(['monthKey', 'leagueId', 'participants', 'status', 'snapshot', 'updatedAt', 'updatedBy'])
        && d.monthKey == monthKey
        && d.leagueId is int && d.leagueId > 0
        && d.participants is list && d.participants.size() <= 100
        && d.status in ['open', 'finalized']
        && ((d.status == 'open' && d.snapshot == null) || (d.status == 'finalized' && d.snapshot is map))
        && isStamped(d);
    }

    match /admins/{email} {
      // A user may only check whether they themselves are an admin.
      allow get: if isSignedIn() && callerEmail() == email;
      allow list, write: if false;
    }

    match /settings/league {
      allow read: if true;
      allow write: if isAdmin() && isValidLeagueSettings(request.resource.data);
    }

    match /settings/fdr {
      allow read: if true;
      allow write: if isAdmin() && isValidFdrSettings(request.resource.data);
    }

    match /months/{monthKey} {
      allow read: if true;
      allow create, update: if isAdmin()
        && monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && isValidMonth(request.resource.data, monthKey);
      allow delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
